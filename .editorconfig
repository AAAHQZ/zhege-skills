# 本仓库所有文本文件统一 UTF-8（无 BOM）+ LF 换行。
#
# 为什么要显式锁死：
#   1. Windows 上 PowerShell 5.1 的 Set-Content -Encoding UTF8、记事本、部分编辑器
#      默认写 UTF-8 **带 BOM**；GBK 则是中文 Windows 的系统 ANSI 码页。
#   2. 本仓库脚本读配置/语料时用 utf-8-sig（容忍 BOM），但**写**一律 utf-8 无 BOM。
#      两种编码混在一起时，肉眼完全看不出来，只有脚本读的时候才炸。
#   3. 行尾同理：被 CRLF 检出后 `.tsv` 的表头会多带一个 \r，解析直接失败。
#
# 这是「让默认值就是对的」—— 依赖每台机器/每个编辑器的设置迟早会漏。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Markdown 行尾两个空格是「硬换行」语法，不能被裁掉
trim_trailing_whitespace = false
indent_size = 2

[*.{tsv,json}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100
